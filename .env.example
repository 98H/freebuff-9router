# freebucks-proxy environment template — deployed by freebuff-9router
# Copy to /etc/freebucks-proxy/env and adjust. Keep AUTH_TOKENS empty: this
# stack runs in BRIDGE mode, meaning every request's Authorization Bearer IS
# the upstream FreeBuff token (stored only in 9Router's SQLite, relayed
# per-request). See https://github.com/trefeon/freebucks-proxy README for the
# full key reference.

# Loopback only. Never expose 3457 to a public interface.
LISTEN_ADDR=127.0.0.1:3457

UPSTREAM_BASE_URL=https://www.codebuff.com

# Anti-ban preset: CLI-faithful egress, 200ms jitter, 30m idle rotation.
SAFE_MODE=true

# MUST stay "free": anything else routes requests as PAID and fresh free
# accounts get 402 "Out of credits".
COST_MODE=free

# Bridge mode — do NOT put tokens here. Add accounts with:
#   python3 freebuff9r.py login-url && python3 freebuff9r.py wait-login ...
AUTH_TOKENS=

# Admin dashboard token (generate: openssl rand -hex 24). Dashboard is
# loopback-only; reach it via `ssh -L 3457:127.0.0.1:3457 host`.
ADMIN_TOKEN=CHANGE_ME

LOG_LEVEL=info
LOG_ACCESS=true
