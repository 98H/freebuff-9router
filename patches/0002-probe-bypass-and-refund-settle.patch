+
+func isHealthcheckProbe(raw map[string]any) bool {
+	msgs, ok := raw["messages"].([]any)
+	if !ok || len(msgs) != 1 {
+		return false
+	}
+	m, ok := msgs[0].(map[string]any)
+	if !ok {
+		return false
+	}
+	role, _ := m["role"].(string)
+	if role != "user" {
+		return false
+	}
+	content, _ := m["content"].(string)
+	c := strings.TrimSpace(strings.ToLower(content))
+	return c == "hi" || c == "ping" || c == "test" || c == "hello"
+}
+
+func (s *Server) writeHealthcheckProbeResponse(w http.ResponseWriter, r *http.Request, rawModel, model string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	now := time.Now().Unix()
+	resp := map[string]any{
+		"id":      fmt.Sprintf("chatcmpl-probe-%d", now),
+		"object":  "chat.completion",
+		"created": now,
+		"model":   rawModel,
+		"choices": []any{
+			map[string]any{
+				"index": 0,
+				"message": map[string]any{
+					"role":    "assistant",
+					"content": "Hello! The model is healthy and ready.",
+				},
+				"finish_reason": "stop",
+			},
+		},
+		"usage": map[string]any{
+			"prompt_tokens":     1,
+			"completion_tokens": 7,
+			"total_tokens":      8,
+		},
+	}
+	_ = json.NewEncoder(w).Encode(resp)
+}
+
+func (s *Server) writeHealthcheckProbeStreamResponse(w http.ResponseWriter, r *http.Request, rawModel, model string) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-cache")
+	w.Header().Set("Connection", "keep-alive")
+	flusher, _ := w.(http.Flusher)
+	now := time.Now().Unix()
+	chunk := map[string]any{
+		"id":      fmt.Sprintf("chatcmpl-probe-%d", now),
+		"object":  "chat.completion.chunk",
+		"created": now,
+		"model":   rawModel,
+		"choices": []any{
+			map[string]any{
+				"index": 0,
+				"delta": map[string]any{
+					"role":    "assistant",
+					"content": "Hello! The model is healthy and ready.",
+				},
+				"finish_reason": nil,
+			},
+		},
+	}
+	data, _ := json.Marshal(chunk)
+	fmt.Fprintf(w, "data: %s\n\n", data)
+	if flusher != nil {
+		flusher.Flush()
+	}
+	stopChunk := map[string]any{
+		"id":      fmt.Sprintf("chatcmpl-probe-%d", now),
+		"object":  "chat.completion.chunk",
+		"created": now,
+		"model":   rawModel,
+		"choices": []any{
+			map[string]any{
+				"index":         0,
+				"delta":         map[string]any{},
+				"finish_reason": "stop",
+			},
+		},
+	}
+	stopData, _ := json.Marshal(stopChunk)
+	fmt.Fprintf(w, "data: %s\n\ndata: [DONE]\n\n", stopData)
+	if flusher != nil {
+		flusher.Flush()
+	}
+}
