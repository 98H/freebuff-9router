 func (s *Server) handleModels(w http.ResponseWriter, r *http.Request) {
+	// In bridge mode, if an explicit Bearer token is provided (e.g. from 9Router's /api/providers/validate),
+	// validate the token via bridge cache / upstream probe so the test connection check works accurately.
+	if auth := r.Header.Get("Authorization"); auth != "" {
+		if tok, ok := extractBearerToken(auth); ok && tok != "" && tok != "freebuff-bridge-pending" {
+			cfg := s.cfg.Load()
+			if cfg.BridgeMode() || cfg.HybridBridgeMode() {
+				if err := s.pool.ValidateBridgeToken(tok); err != nil {
+					s.writeJSONError(w, http.StatusUnauthorized,
+						"Invalid API key: "+err.Error(), "invalid_request_error", "invalid_api_key", 0)
+					return
+				}
+			}
+		}
+	}
+
